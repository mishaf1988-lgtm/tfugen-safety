# Secrets — never commit
.env
.env.*
*.key
*.pem
secrets.json
.dev.vars

# Local backups — operational data, keep out of version control
backups/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
node_modules/

# VM notifier (tools/vm-notifier) — local config with mail password, state and log
tools/vm-notifier/config.json
tools/vm-notifier/state.json
tools/vm-notifier/notifier.log
__pycache__/
*.pyc
