{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__github__pull_request_read",
      "mcp__Supabase__execute_sql",
      "mcp__supabase__execute_sql",
      "mcp__github__list_pull_requests",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "Bash(bash tests/harness/run.sh:*)",
      "Bash(node tests/harness/:*)",
      "Bash(python3 tests/harness/:*)",
      "Bash(python3 .claude/hooks/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(sleep:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*__execute_sql|mcp__.*__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-sql.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*365.*|mcp__.*__(outlook|sharepoint|onedrive|teams|graph)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-365.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lean-harness.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fresh-main.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/merge-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.py"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/live-check.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/questionnaire-hebrew.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkout-guard.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pkill-guard.py"
          }
        ]
      },
      {
        "matcher": "ArtifactData",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cowork-gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trigger-prompt-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/desc-hebrew.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/raw-hebrew.py"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ci-watch.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-recheck.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hebrew-midturn.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hebrew-reply.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/questionnaire-gate.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/paste-guard.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/supervisor.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You check the final reply that Claude wrote to Michael, a factory safety manager who reads it in Hebrew. Input JSON: $ARGUMENTS\nIf stop_hook_active is true, answer {\"ok\": true}. Otherwise read last_assistant_message and answer ok:false ONLY for a clear breach of one of these rules. When unsure, ok:true. Technical names (files, PR numbers, code) in Latin letters are fine.\n1. A question or a choice for Michael written as text (\"רוצה ש...?\", \"להמשיך?\", \"אשאל אותך בסוף\", options to pick from). Questions go in a questionnaire tool, not text. A line \"בלי שאלון: ...\" is fine.\n2. Asking permission for something Claude does on its own: merging a PR, writing code, searching, checking, opening a branch.\n3. Asking Michael to check or look something up that Claude can check itself (database, code, logs, GitHub). A real phone, a physical site, or his own inbox are fine.\n4. Saying something is done, fixed, sent or verified with no word on how it was checked. A reply that names the check (\"נבדק במסד\", \"אומת\", \"הבדיקות עברו\") is fine.\n5. A date in Hebrew text not written as DD/MM/YYYY or DD/MM (for example 2026-10-27 or \"October 27\"). Dates inside code, file names or branch names are fine.\n6. A long dash character (—).\nAnswer only JSON: {\"ok\": true} or {\"ok\": false, \"reason\": \"<rule number and the exact words that break it, in Hebrew, one line>\"}.",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hebrew-prompt.py"
          }
        ]
      }
    ]
  }
}
