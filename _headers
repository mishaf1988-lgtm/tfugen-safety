# Cloudflare Pages: per-URL HTTP header overrides.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Order is important — more specific paths last.

# ---- Defaults applied to every response ----
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP intentionally permissive — the app has 478 inline onclicks and
  # 767 inline styles. The policy still adds real protection against:
  # (a) script injection from unknown origins, (b) plugin objects,
  # (c) <base> tag injection, (d) form posts to evil sites, (e) framing.
  # Tighter protection later requires migrating inline handlers to event listeners.
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://alcdn.msauth.net https://alcdn.msftauth.net https://login.microsoftonline.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https: wss:; frame-src 'self' https://login.microsoftonline.com https://login.live.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# ---- HTML + Service Worker: never serve a stale copy ----
# Network-first SW already does this client-side; the header makes
# the CDN/proxy honour it too, so the SW always sees the latest bytes.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

# ---- PWA manifest: short-cache so we can update install metadata fast ----
/manifest.webmanifest
  Cache-Control: public, max-age=300

# ---- Static brand assets: long-cache (rename file if the image changes) ----
/icon.svg
  Cache-Control: public, max-age=86400

/logo.jpg
  Cache-Control: public, max-age=86400
